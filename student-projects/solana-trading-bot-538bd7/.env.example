# ---------------------------------------------------------------------------
# USF Solana Trading Bot - environment
# Copy to .env and fill in. .env is git-ignored and never read by the browser.
# Nothing in here is ever logged, returned by the API, or shown in the UI.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
DATABASE_URL=file:./data/usf.db

# --- Trading mode ------------------------------------------------------------
# paper | live   Starting value only; the dashboard's mode button changes this
# live, no restart needed, as soon as a wallet key below is configured.
TRADING_MODE=paper

# --- Solana ------------------------------------------------------------------
SOLANA_RPC_URL=https://solana-mainnet.gateway.tatum.io/
# Tatum's gateway wants the key in an x-api-key header rather than in the URL,
# which is what this is for. Leave it blank for an RPC that carries its key
# inside SOLANA_RPC_URL instead.
SOLANA_RPC_API_KEY=
HELIUS_API_KEY=

# --- Wallet (live mode only, never needed for paper) -------------------------
# Base58 secret key, the string Phantom exports. Paper mode ignores it.
# Never commit this. Never paste it anywhere but your own .env file.
WALLET_PRIVATE_KEY=

# --- Data providers ----------------------------------------------------------
# DexScreener needs no key.
LUNARCRUSH_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Optional ----------------------------------------------------------------
# Comma separated origins allowed to call the API. Defaults to localhost only.
CORS_ORIGINS=
