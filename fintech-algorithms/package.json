{
  "name": "usf-fintech-algorithms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/clean-dist.mjs && astro build && pagefind --site dist && node scripts/service-worker.mjs",
    "build:offline": "pnpm build && node scripts/package-offline.mjs",
    "preview": "astro preview",
    "validate": "node --import tsx scripts/validate.ts",
    "explanations:queue": "node --import tsx scripts/explanation-queue.ts",
    "test": "node --import tsx scripts/explanation-queue.ts --generate && vitest run",
    "test:e2e": "playwright test",
    "check": "node --import tsx scripts/explanation-queue.ts --generate && astro check && svelte-check --tsconfig tsconfig.json",
    "format": "prettier --write src scripts tests",
    "vendor:python": "python3 scripts/vendor-python.py",
    "build:labs": "python3 scripts/build-labs.py",
    "test:notebooks": "node scripts/notebook-browser.mjs",
    "test:performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/starlight": "0.42.4",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.3.5",
    "d3": "7.9.0",
    "katex": "0.19.1",
    "reveal.js": "6.0.2",
    "svelte": "5.57.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "138.0.2",
    "@types/d3": "7.4.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.3",
    "@types/reveal.js": "5.2.2",
    "chrome-launcher": "1.2.2",
    "eslint": "10.11.0",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
